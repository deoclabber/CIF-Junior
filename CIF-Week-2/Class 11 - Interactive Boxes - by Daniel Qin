import pygame
from random import randint
pygame.init()

pink = (225, 105, 180)
green = (0, 130, 0)
blue = (0, 0, 200)
space = (0, 0, 20)

width = 1000
height = 800
my_font = pygame.font.SysFont("helvetica", 40)
text_surface = my_font.render("Welcome!", False, (255, 255, 255))
box1_x = 0
box1_y = 100
box2_x = width // 2
box2_y = height // 2
box1_x_change = 0
box1_y_change = 0
box1_speed = 9
move_up = False
move_left = False
move_down = False
move_right = False
counter = 0

screen = pygame.display.set_mode((width, height))
clock = pygame.time.Clock()

while True:
    clock.tick(30)
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            exit()
        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_UP:
                box1_y_change = -box1_speed
                move_up = True
            if event.key == pygame.K_LEFT:
                box1_x_change = -box1_speed
                move_left = True
            if event.key == pygame.K_DOWN:
                box1_y_change = box1_speed
                move_down = True 
            if event.key == pygame.K_RIGHT:
                move_right = True                 
                box1_x_change = box1_speed
        elif event.type == pygame.KEYUP:
            if event.key == pygame.K_UP:
                move_up = False
                box1_y_change = 0
            if event.key == pygame.K_LEFT:
                move_left = False
                box1_x_change = 0
            if event.key == pygame.K_DOWN:
                move_down = False
                box1_y_change = 0
            if event.key == pygame.K_RIGHT:
                move_right = False
                box1_x_change = 0

    box1_x += box1_x_change
    box1_y += box1_y_change

    if box1_x < 0:
        box1_x = 0 
    if box1_x > width - 50:
        box1_x = width - 50
    if box1_y < 0:
        box1_y = 0 
    if box1_y > height - 50:
        box1_y = height - 50

    rect1 = pygame.Rect(box1_x, box1_y, 30, 30)
    rect2 = pygame.Rect(box2_x, box2_y, 50, 50)

    pygame.draw.rect(screen, pink, rect1)
    pygame.draw.rect(screen, green, rect2)

    if rect1.colliderect(rect2):
        my_font2 = pygame.font.SysFont("helvetica", 40)
        text_surface2 = my_font.render("You are touching the green box...", False, (255, 255, 197))
        screen.blit(text_surface2, (20, 740))
        pygame.draw.rect(screen, blue, rect2)
        box1_x = box1_x - box1_x_change
        box1_y = box1_y - box1_y_change

    pygame.display.update()
    screen.fill(space)
    screen.blit(text_surface, (20, 20))
